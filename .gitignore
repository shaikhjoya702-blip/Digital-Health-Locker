# ==========================================
# Digital Health Locker - Git Ignore
# ==========================================

# Environment Variables & Secrets (CRITICAL)
.env
.env.production
.env.staging
.env.development
.env.local
.env.*.local
*.env
backend/.env
frontend/.env
!.env.example
!backend/.env.example
!frontend/.env.example

# Python Virtual Environments & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/venv/
venv/
env/
ENV/
backend/env/
.venv/
.pytest_cache/
.coverage
htmlcov/

# Node & Frontend Build Artifacts
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# User Storage & Uploaded Medical Documents (HIPAA / Privacy)
backend/storage/records/*
!backend/storage/records/.gitkeep
!backend/storage/records/sample_cbc_panel.pdf
storage/records/*
!storage/records/.gitkeep

# Operating System & Editor Metadata
.DS_Store
Thumbs.db
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Logs & Temporary files
*.log
logs/
backend/logs/
tmp/
temp/

