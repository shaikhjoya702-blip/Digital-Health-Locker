# Flask Backend Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-to-a-very-strong-secret-key-at-least-32-chars-long
JWT_SECRET_KEY=change-to-another-strong-jwt-secret-key-32-chars
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Neon Tech Serverless PostgreSQL Database Configuration
# Obtain your connection URI from your Neon Console (neon.tech)
# Example: postgresql://neondb_owner:npg_xxxxxx@ep-xyz-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:<your_neon_password>@<your_neon_endpoint>.neon.tech/neondb?sslmode=require

# Storage Settings
STORAGE_DIR=./storage/records
MAX_CONTENT_LENGTH=15728640  # 15 MB max file upload
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg

# OCR Settings (Tesseract executable path on Windows, or leave blank on Linux/Mac if in PATH)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# AI Provider Settings (Google Gemini)
GEMINI_API_KEY=your-gemini-api-key-here
AI_MODEL_NAME=gemini-1.5-flash

# Official Email Service Configuration
# Primary designated support contact & sender
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=xoya0102@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_DEFAULT_SENDER=xoya0102@gmail.com
SUPPORT_EMAIL=xoya0102@gmail.com

# Base Application URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
